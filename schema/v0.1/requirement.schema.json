{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openquality.dev/schema/v0.1/requirement.schema.json",
  "title": "QualityRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "kind", "metadata", "spec"],
  "properties": {
    "specVersion": { "const": "0.1" },
    "kind": { "const": "QualityRequirement" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "priority", "qualityMeasures"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["low", "medium", "high", "critical"] },
        "qualityMeasures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["qualityMeasure", "target"],
            "properties": {
              "qualityMeasure": { "$ref": "common.schema.json#/$defs/reference" },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operator", "value"],
                "properties": {
                  "operator": { "$ref": "common.schema.json#/$defs/operator" },
                  "value": { "$ref": "common.schema.json#/$defs/value" },
                  "unit": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "documentation": { "$ref": "common.schema.json#/$defs/referenceList" }
      }
    }
  }
}
