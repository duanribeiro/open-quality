{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openquality.dev/schema/v0.1/metric.schema.json",
  "title": "QualityMeasure",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "kind", "metadata", "spec"],
  "properties": {
    "specVersion": { "const": "0.1" },
    "kind": { "const": "QualityMeasure" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measurementFunction": { "type": "object", "additionalProperties": false, "required": ["expression", "elements"], "properties": { "expression": { "type": "string", "minLength": 1 }, "elements": { "$ref": "common.schema.json#/$defs/referenceList" } } },
        "unit": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "sourceHint": { "type": "string" }
      }
    }
  }
}
