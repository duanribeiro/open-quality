{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openquality.dev/schema/v0.1/stage.schema.json",
  "title": "Stage",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "kind", "metadata", "spec"],
  "properties": {
    "specVersion": { "const": "0.1" },
    "kind": { "const": "Stage" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "reviewScope": { "type": "string", "minLength": 1 },
        "pipeline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "enum": ["linter", "build", "unit-tests", "integration-tests", "static-analysis", "vulnerability-scan", "secrets-scan", "artifact-generation", "deploy", "approval"] },
              "environment": { "type": "string", "minLength": 1 },
              "approvalPolicy": { "$ref": "common.schema.json#/$defs/reference" }
            },
            "allOf": [
              {
                "if": { "properties": { "type": { "const": "deploy" } }, "required": ["type"] },
                "then": { "required": ["environment"] }
              },
              {
                "if": { "properties": { "type": { "const": "approval" } }, "required": ["type"] },
                "then": { "required": ["approvalPolicy"] }
              }
            ]
          }
        },
        "description": { "type": "string" },
        "dependsOn": { "$ref": "common.schema.json#/$defs/referenceList" },
        "owner": { "$ref": "common.schema.json#/$defs/reference" },
        "owners": { "$ref": "common.schema.json#/$defs/referenceList" },
        "documentation": { "$ref": "common.schema.json#/$defs/referenceList" },
        "approvalPolicy": { "$ref": "common.schema.json#/$defs/reference" }
      }
    }
  }
}
